# The web dashboard's settings, for docker run --env-file. Copy this file to dashboard.env and fill in the values.
# dashboard.env never goes into Git or an image: .gitignore and .dockerignore leave out every *.env file. On the server,
# setup-dashboard.sh writes /opt/minerbot/dashboard.env itself (deploy/README.md).
# Every value follows one rule, because docker compose and docker run --env-file read anything else differently:
# printable ASCII only; none of $, ", ', \ and the backtick; no space at the start or the end; no # right after a space;
# spaces inside a value are fine.

# Where people open the dashboard. Discord's sign-in comes back to /signin-discord there.
Dashboard__PublicOrigin=https://bot.murderminershub.com

# The secret nginx adds to every request it passes on, as the X-MinerBot-Proxy-Key header. Without it the dashboard
# answers 404, so nothing else on the server can use it.
Dashboard__ProxyKey={Proxy Key: 64 random hex characters, the value nginx sends}

# Numeric Discord user IDs. Each account needs Discord two-factor turned on to sign in.
Dashboard__Owners={Owner's Discord User ID}
Dashboard__Admins={Admins' Discord User IDs, separated by commas (optional)}

# The MinerBot Dashboard application in the Discord Developer Portal, not the bot's own
Discord__ClientId={MinerBot Dashboard Client ID}
Discord__ClientSecret={MinerBot Dashboard Client Secret}

# Cloudflare Access, optional. With both set, /admin also needs the signed token Access adds to each request it let
# through: the team's host name, such as {Team Name}.cloudflareaccess.com, and the Access application's AUD tag, 64
# characters of 0-9 and a-f. Both or neither: with both empty the check is off.
CloudflareAccess__TeamDomain=
CloudflareAccess__Audience=

# The dashboard's own login. The two pools stay under the login's 15 connections. On the database's own server,
# setup-dashboard.sh writes them as Server=127.0.0.1;Port=3306;Database={Database Name};Uid=minerbot-dashboard;
# Pwd={Password};SslMode=Disabled;Connection Timeout=15;CharSet=utf8mb4;Maximum Pool Size=6; without TLS, because the
# connection never leaves the server.
ConnectionStrings__DefaultConnection=SERVER={Server Host};PORT=3306;DATABASE={Website Database Name};UID={Dashboard User ID};PASSWORD={Password};SSLMODE=Preferred;Connection Timeout=30;CharSet=utf8mb4;Maximum Pool Size=6;
ConnectionStrings__BotConnection=SERVER={Server Host};PORT=3306;DATABASE={MinerBot Database Name};UID={Dashboard User ID};PASSWORD={Password};SSLMODE=Preferred;Connection Timeout=30;CharSet=utf8mb4;Maximum Pool Size=6;

# The image sets the keys folder, and the dashboard listens on 127.0.0.1:5080 unless these say otherwise. With
# Dashboard__UnixSocket, a full path of at most 100 bytes, it listens only on that Unix socket instead. On the server
# compose.yml sets it to /run/minerbot-dashboard/dashboard.sock, where nginx reaches the dashboard, so it isn't set here.
#Dashboard__KeysFolder=/app/keys
#Dashboard__ListenAddress=127.0.0.1
#Dashboard__Port=5080
#Dashboard__UnixSocket=
