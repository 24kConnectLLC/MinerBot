# The web dashboard's settings, for docker run --env-file. Copy this file to dashboard.env and fill in the values.
# dashboard.env never goes into Git or an image: .gitignore and .dockerignore leave out every *.env file.

# Where people open the dashboard. Discord's sign-in comes back to /signin-discord there.
Dashboard__PublicOrigin=https://bot.murderminershub.com

# The secret nginx adds to every request it passes on, as the X-MinerBot-Proxy-Key header. Without it the dashboard
# answers 404, so nothing else on the server can use it.
Dashboard__ProxyKey={Proxy Key: 64 random hex characters, the value nginx sends}

# Numeric Discord user IDs. Each account needs Discord two-factor turned on to sign in.
Dashboard__Owners={Owner's Discord User ID}
Dashboard__Admins={Admins' Discord User IDs, separated by commas (optional)}

# The MinerBot Dashboard application in the Discord Developer Portal, not the bot's own
Discord__ClientId={MinerBot Dashboard Client ID}
Discord__ClientSecret={MinerBot Dashboard Client Secret}

# The dashboard's own login. The two pools stay under the login's 15 connections.
ConnectionStrings__DefaultConnection=SERVER={Server Host};PORT=3306;DATABASE={Website Database Name};UID={Dashboard User ID};PASSWORD={Password};SSLMODE=Preferred;Connection Timeout=30;CharSet=utf8mb4;Maximum Pool Size=6;
ConnectionStrings__BotConnection=SERVER={Server Host};PORT=3306;DATABASE={MinerBot Database Name};UID={Dashboard User ID};PASSWORD={Password};SSLMODE=Preferred;Connection Timeout=30;CharSet=utf8mb4;Maximum Pool Size=6;

# The image sets the keys folder, and the dashboard listens on 127.0.0.1:5080 unless these say otherwise
#Dashboard__KeysFolder=/app/keys
#Dashboard__ListenAddress=127.0.0.1
#Dashboard__Port=5080
