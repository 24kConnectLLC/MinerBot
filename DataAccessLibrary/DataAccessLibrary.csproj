<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="MySql.Data" Version="26.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinerBot.Shared\MinerBot.Shared.csproj" />
  </ItemGroup>

  <!-- The migrations for MinerBot's own database: every file in the folder but the code, so one named the wrong way is
       refused by name rather than left out. The name is set, so MSBuild can't change one that starts with digits. -->
  <ItemGroup>
    <None Remove="Migrations\*" />
    <EmbeddedResource Include="Migrations\*" Exclude="Migrations\*.cs" LogicalName="Migrations/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MinerBot.Tests" />
    <InternalsVisibleTo Include="DataAccessLibrary.Tests" />
    <!-- For the database fixture the dashboard's tests share with DataAccessLibrary.Tests -->
    <InternalsVisibleTo Include="MinerBot.Dashboard.Tests" />
  </ItemGroup>

</Project>
