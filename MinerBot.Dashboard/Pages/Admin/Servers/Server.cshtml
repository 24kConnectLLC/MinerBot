@page "/Admin/Servers/{id:long}"
@model ServerPageModel
@using System.Globalization
@using DataAccessLibrary.Guilds
@using MinerBot.Dashboard.Armor
@using MinerBot.Dashboard.Requests
@using MinerBot.Dashboard.Servers
@using MinerBot.Dashboard.Status
@*
    Server, category and channel names are Discord's, which anyone in a server can set, so each goes through RevealedText,
    inside a bdi, and the title never holds one; a test message's options hold text alone, so a channel's name there has
    its hidden characters written as their codes. IDs are text. Channels hidden from MinerBot are counted, not listed, since
    Discord sends each one with the same made-up name. A table here holds at most a setting's link to another server and
    links to the bot's messages in Discord, which a table may not have, so each one's wrapper takes the keyboard's focus
    itself, as a group named by its heading, and a keyboard can scroll one too wide for a phone: Safari, unlike Chrome and
    Firefox, doesn't make a scrolling box focusable on its own. A message's link is built from three numbers, never from
    text. The actions' forms and the switches' post to this page through asp-page-handler, never an action attribute, so
    the form tag helper adds their token, each action's with a key of its own; the box of the request a form sent
    refreshes itself through refresh.js until it's final, and the page works without it. A save of the switches redirects
    to their heading, so its word is drawn under it, where the page opens, and not with the notices at the top.
*@
@{
    ViewData["Title"] = "Server " + Model.IdText;
    ViewData["Wide"] = true;
    var server = Model.Server;
    var now = Model.Now;
}
@section Scripts {
    @if (Model.Result is { View.Final: false })
    {
        <script src="~/js/refresh.js" asp-append-version="true" defer></script>
    }
}
<p><a href="/admin/servers">Back to the servers</a></p>
<h1>Server @Model.IdText</h1>

@if (Model.Problem != null)
{
    <div class="notice notice-problem" role="alert">
        <p>@Model.Problem @if (Model.ProblemRequest is { } named) {<a href="@("/admin/requests/" + named.ToString(CultureInfo.InvariantCulture))">That request</a>}</p>
    </div>
}

@if (Model.SwitchNotice != null)
{
    <div class="notice @(Model.SwitchNoticeIsProblem ? "notice-problem" : "notice-done")" role="@(Model.SwitchNoticeIsProblem ? "alert" : "status")">
        <p>@Model.SwitchNotice</p>
    </div>
}

@if (server == null)
{
    <div class="banner" role="note">
        <p>MinerBot isn't in this server: its copy of its servers has never recorded it. The website has settings for it, so posts to it are skipped.</p>
    </div>
}
else
{
    @if (Model.Freshness is { } freshness)
    {
        <partial name="_CopyFreshness" model="freshness" />
    }

    <section aria-labelledby="server">
        <h2 id="server">The server</h2>
        <div class="server-name">
            @if (Model.IconUrl is { } icon)
            {
                <img class="server-icon" src="@icon" alt="" width="32" height="32" />
            }
            else
            {
                <span class="server-icon server-icon-none"></span>
            }
            <p class="cell-line">@RevealedText.Html(server.name)</p>
        </div>
        <dl class="details">
            <dt>Server ID</dt>
            <dd class="address">@Model.IdText</dd>
            <dt>MinerBot</dt>
            <dd>
                @if (server.left_at is { } left)
                {
                    <text>Left on @TimeWords.Utc(left), so posts to this server are skipped.</text>
                }
                else
                {
                    <text>In this server</text>@if (server.bot_joined_at is { } joined) {<text> since @TimeWords.Utc(joined)</text>}<text>.</text>
                }
            </dd>
            @if (server.left_at != null && server.bot_joined_at is { } joinedBefore)
            {
                <dt>Joined</dt>
                <dd>@TimeWords.Utc(joinedBefore)</dd>
            }
            <dt>Members</dt>
            <dd>
                @if (server.member_count is { } members)
                {
                    @members.ToString("N0", CultureInfo.InvariantCulture)
                }
                else
                {
                    <text>Not counted</text>
                }
                @if (Model.Trend is { } trend)
                {
                    <span class="muted">(@ServerRows.TrendWords(trend, ServerPageModel.TrendDays))</span>
                }
            </dd>
            @if (Model.IsIn && server.bot_administrator)
            {
                <dt>Permissions</dt>
                <dd><span class="marker marker-warn">Has Administrator</span> @ServerRows.AdministratorAdvice</dd>
            }
            @if (Model.IsIn && !server.available)
            {
                <dt>Outage</dt>
                <dd><span class="marker marker-warn">Unavailable</span> Discord reports this server unavailable, so its channels are as they were before, and posts to it are skipped until it's back.</dd>
            }
        </dl>
        @if (Model.MemberDays.Count > 0)
        {
            <details>
                <summary id="member-days">Members on each day counted, over the last @ServerPageModel.TrendDays days</summary>
                <div class="table-wrap" tabindex="0" role="group" aria-labelledby="member-days">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Day</th>
                                <th scope="col">Members</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var day in Model.MemberDays.Reverse())
                            {
                                <tr>
                                    <th scope="row" class="audit-when">@TimeWords.Day(day.day)</th>
                                    <td>@(day.member_count is { } count ? count.ToString("N0", CultureInfo.InvariantCulture) : "Not counted")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </section>
}

@if (Model.Result != null)
{
    <partial name="_RequestSection" model="Model.Result" />
}

<section aria-labelledby="actions">
    <h2 id="actions">@ServerActions.Heading</h2>
    @if (Model.Actions != ServerActionState.Offered)
    {
        <p>@ServerActions.Line(Model.Actions)</p>
    }
    else
    {
        var test = Model.Control(ServerActions.TestMessage);
        var offered = Model.TestChannels.Where(channel => channel.Offered).ToList();
        var refused = Model.TestChannels.Where(channel => !channel.Offered).ToList();

        <div class="control">
            <partial name="_Control" model="test" />
            @if (Model.TestChannels.Count == 0)
            {
                <p>@ServerActions.NoChannels</p>
            }
            else if (offered.Count == 0)
            {
                <p>@ServerActions.NoneOffered</p>
            }
            else
            {
                <form method="post" asp-page-handler="@ServerActions.TestMessage" asp-route-id="@Model.IdText">
                    <input type="hidden" name="formkey" value="@test.FormKey" />
                    <div class="field">
                        <label for="test-channel">@ServerActions.ChannelLabel</label>
                        <select id="test-channel" name="channel">
                            @foreach (var channel in offered)
                            {
                                <option value="@channel.IdText" selected="@(channel.Id == Model.PostedChannel)">@ServerActions.Label(channel)</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="button" aria-describedby="@test.HelpId">@test.Label</button>
                </form>
            }
            @if (refused.Count > 0)
            {
                <ul>
                    @foreach (var channel in refused)
                    {
                        <li>@ServerActions.KindsText(channel.Kinds): @if (channel.Channel is { } known && !ChannelGroups.IsHidden(known)) {<text>#</text>@RevealedText.Html(known.name)} else {<text>channel </text><span class="address">@channel.IdText</span>@(channel.Channel == null ? "" : ", hidden from MinerBot,")} can't take the test message: @channel.Why.</li>
                    }
                </ul>
            }
        </div>

        var refresh = Model.Control(ServerActions.Refresh);
        <div class="control">
            <partial name="_Control" model="refresh" />
            <form method="post" asp-page-handler="@ServerActions.Refresh" asp-route-id="@Model.IdText">
                <input type="hidden" name="formkey" value="@refresh.FormKey" />
                <button type="submit" class="button" aria-describedby="@refresh.HelpId">@refresh.Label</button>
            </form>
        </div>

        @if (Model.IsOwner)
        {
            <div class="control">
                <p><a href="@Model.LeaveLink">@ServerActions.LeaveLink&hellip;</a></p>
                <partial name="_RequestLine" model="Model.LastLeave" />
            </div>
        }
    }
</section>

<section aria-labelledby="settings">
    <h2 id="settings">Its channels for MinerBot's posts</h2>
    @if (Model.Settings == null)
    {
        <p>Not set up: this server never chose its channels with /admin set_channels, so MinerBot posts nothing to it.</p>
    }
    <div class="table-wrap" tabindex="0" role="group" aria-labelledby="settings">
        <table>
            <thead>
                <tr>
                    <th scope="col">Posts</th>
                    <th scope="col">Channel</th>
                    <th scope="col">Status</th>
                    <th scope="col">Last post</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var setting in Model.Statuses)
                {
                    var channelId = setting.ChannelId.ToString(CultureInfo.InvariantCulture);
                    var delivery = DeliveryWords.Shown(Model.Delivery(setting.Kind), setting.State);
                    <tr>
                        <th scope="row">@SettingStatuses.KindLabel(setting.Kind)</th>
                        <td>
                            @if (setting.Channel is { } channel && channel.guild_id == Model.Id)
                            {
                                <p class="cell-line">@if (ChannelGroups.IsHidden(channel)) {<text>A channel hidden from MinerBot</text>} else {@RevealedText.Html(channel.name)}</p>
                                <p class="cell-line muted address">@channelId</p>
                            }
                            else if (setting.ChannelId != 0)
                            {
                                <p class="cell-line address">@channelId</p>
                            }
                            else
                            {
                                <text>None</text>
                            }
                        </td>
                        <td>
                            <span class="marker @SettingStatuses.Marker(setting.State)">@SettingStatuses.Words(setting)</span>
                            @switch (setting.State)
                            {
                                case SettingState.Off:
                                    <p class="cell-line muted">The server turned this kind of post off.</p>
                                    break;
                                case SettingState.SwitchedOff:
                                    <p class="cell-line muted">@SwitchWords.SwitchedOffLine</p>
                                    break;
                                case SettingState.CantPost:
                                    <p class="cell-line muted">Give MinerBot @string.Join(", ", setting.Missing) in this channel, or choose another.</p>
                                    break;
                                case SettingState.OtherServer:
                                    var other = setting.Channel!.guild_id;
                                    <p class="cell-line muted">The channel is in server @if (ServerRows.Link(other) is { } otherLink) {<a href="@otherLink" class="address">@other.ToString(CultureInfo.InvariantCulture)</a>} else {<span class="address">@other.ToString(CultureInfo.InvariantCulture)</span>}, and MinerBot never posts one server's notifications in another's channel.</p>
                                    break;
                                case SettingState.CantCheck:
                                    <p class="cell-line muted">MinerBot's copy has no text or announcement channel with this ID. It may be a voice channel's chat, which posts do reach, a forum, or a channel that was deleted.</p>
                                    break;
                            }
                        </td>
                        <td>
                            @if (SettingStatuses.SourceOf(setting.Kind) == null)
                            {
                                <text>@DeliveryWords.NotRecorded</text>
                            }
                            else if (delivery is { failing_since: not null } failing)
                            {
                                <p class="cell-line">@DeliveryWords.CouldntPost(failing)</p>
                                @if (DeliveryWords.NextTry(failing, now) is { } next)
                                {
                                    <p class="cell-line muted">@next</p>
                                }
                            }
                            else if (delivery is { last_sent_at: { } sent } posted)
                            {
                                <p class="cell-line">@DeliveryWords.Posted(sent)</p>
                                @if (DeliveryWords.LastPostLink(posted) is { } link)
                                {
                                    <p class="cell-line"><a href="@link">@DeliveryWords.OpenIt</a></p>
                                }
                            }
                            else if (Model.LastMessage(setting.Kind) is { } message)
                            {
                                <p class="cell-line">@DeliveryWords.Posted(message.attempted_at)</p>
                                @if (DeliveryWords.Link(message) is { } messageLink)
                                {
                                    <p class="cell-line"><a href="@messageLink">@DeliveryWords.OpenIt</a></p>
                                }
                            }
                            else
                            {
                                <text>@DeliveryWords.NoPostYet</text>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (server != null)
    {
        <h3 id="@SwitchWords.Anchor">@SwitchWords.Heading</h3>
        @if (Model.SwitchesDone != null)
        {
            <div class="notice notice-done" role="status">
                <p>@Model.SwitchesDone</p>
            </div>
        }
        <p>@SwitchWords.Help</p>
        @if (Model.Switches is { } saved)
        {
            <p>@SwitchWords.LastChanged(saved.changed_at) @RevealedText.Html(Model.SwitchesChangedBy ?? "")<text>.</text></p>
        }
        else
        {
            <p>@SwitchWords.NoneSaved</p>
        }
        @if (Model.CanChangeSwitches)
        {
            <form method="post" asp-page-handler="@SwitchWords.Handler" asp-route-id="@Model.IdText">
                <input type="hidden" name="version" value="@((Model.Switches?.version ?? 0).ToString(CultureInfo.InvariantCulture))" />
                <div role="group" aria-labelledby="@SwitchWords.Anchor">
                    <div class="field-check">
                        <input type="checkbox" id="switch-armor" name="armor" value="on" checked="@SwitchWords.ArmorOn(Model.Switches)" />
                        <label for="switch-armor">@SwitchWords.ArmorLabel</label>
                    </div>
                    <div class="field-check">
                        <input type="checkbox" id="switch-maps" name="maps" value="on" checked="@SwitchWords.MapsOn(Model.Switches)" />
                        <label for="switch-maps">@SwitchWords.MapsLabel</label>
                    </div>
                    <div class="field-check">
                        <input type="checkbox" id="switch-lobbies" name="lobbies" value="on" checked="@SwitchWords.LobbiesOn(Model.Switches)" />
                        <label for="switch-lobbies">@SwitchWords.LobbiesLabel</label>
                    </div>
                </div>
                <button type="submit" class="button">@SwitchWords.Button</button>
            </form>
        }
        else
        {
            <ul>
                <li>@SwitchWords.ArmorLabel: @SwitchWords.OnOff(SwitchWords.ArmorOn(Model.Switches))</li>
                <li>@SwitchWords.MapsLabel: @SwitchWords.OnOff(SwitchWords.MapsOn(Model.Switches))</li>
                <li>@SwitchWords.LobbiesLabel: @SwitchWords.OnOff(SwitchWords.LobbiesOn(Model.Switches))</li>
            </ul>
            <p>@(Model.IsIn ? SwitchWords.OnlyOwner : SwitchWords.NotIn)</p>
        }
    }
</section>

@if (server != null)
{
    <section aria-labelledby="recent-posts">
        <h2 id="recent-posts">Its recent posts</h2>
        @if (Model.RecentPosts.Count == 0)
        {
            <p>@DeliveryWords.RecentNone</p>
        }
        else
        {
            <p>@DeliveryWords.RecentIntro</p>
            <div class="table-wrap" tabindex="0" role="group" aria-labelledby="recent-posts">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">Posts</th>
                            <th scope="col">Channel</th>
                            <th scope="col">What happened</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model.RecentPosts)
                        {
                            <tr>
                                <td class="audit-when">@TimeWords.Utc(post.attempted_at)</td>
                                <td>@DeliveryWords.Items(post.source, post.item_count)</td>
                                <td>
                                    @if (Model.ChannelOf(post.channel_id) is { } postChannel && !ChannelGroups.IsHidden(postChannel))
                                    {
                                        <p class="cell-line"><text>#</text>@RevealedText.Html(postChannel.name)</p>
                                        <p class="cell-line muted address">@post.channel_id.ToString(CultureInfo.InvariantCulture)</p>
                                    }
                                    else
                                    {
                                        <p class="cell-line address">@post.channel_id.ToString(CultureInfo.InvariantCulture)</p>
                                    }
                                </td>
                                <td>
                                    <p class="cell-line">@DeliveryWords.Outcome(post)</p>
                                    @if (DeliveryWords.Link(post) is { } postLink)
                                    {
                                        <p class="cell-line"><a href="@postLink">@DeliveryWords.OpenIt</a></p>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@if (server != null)
{
    <section aria-labelledby="channels">
        <h2 id="channels">Its channels</h2>
        @if (Model.Groups.Count == 0)
        {
            <p>@(Model.IsIn ? "MinerBot's copy has no text or announcement channel in this server." : "MinerBot's copy keeps no channels of a server it has left.")</p>
        }
        else
        {
            <p>The text and announcement channels, in Discord's order, with whether MinerBot can see each, send messages and embed links there.</p>
            @for (var index = 0; index < Model.Groups.Count; index++)
            {
                var group = Model.Groups[index];
                var category = "category-" + (index + 1).ToString(CultureInfo.InvariantCulture);
                <h3 id="@category">
                    @if (group.CategoryId == null)
                    {
                        <text>Outside any category</text>
                    }
                    else if (ChannelGroups.IsHiddenCategory(group.Category))
                    {
                        <text>A category hidden from MinerBot</text>
                    }
                    else if (string.IsNullOrEmpty(group.Category))
                    {
                        <text>A category with no name</text>
                    }
                    else
                    {
                        @RevealedText.Html(group.Category)
                    }
                </h3>
                @if (group.Channels.Count > 0)
                {
                    <div class="table-wrap" tabindex="0" role="group" aria-labelledby="@category">
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col">Channel</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">View Channel</th>
                                    <th scope="col">Send Messages</th>
                                    <th scope="col">Embed Links</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var channel in group.Channels)
                                {
                                    <tr>
                                        <th scope="row">
                                            <p class="cell-line">@RevealedText.Html(channel.name)</p>
                                            <p class="cell-line muted address">@channel.channel_id.ToString(CultureInfo.InvariantCulture)</p>
                                        </th>
                                        <td>@(channel.type == GuildChannelType.Announcement ? "Announcement" : channel.type == GuildChannelType.Text ? "Text" : channel.type)</td>
                                        <td>@(channel.can_view ? "Yes" : "No")</td>
                                        <td>@(channel.can_send ? "Yes" : "No")</td>
                                        <td>@(channel.can_embed ? "Yes" : "No")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (group.Hidden > 0)
                {
                    <p class="muted">@TimeWords.Count(group.Hidden, "channel") hidden from MinerBot.</p>
                }
            }
        }
    </section>

    <section aria-labelledby="joins">
        <h2 id="joins">Its joins and leaves</h2>
        @if (Model.JoinsAndLeaves.Count == 0)
        {
            <p>None recorded in the last 90 days.</p>
        }
        else
        {
            <div class="table-wrap" tabindex="0" role="group" aria-labelledby="joins">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">What</th>
                            <th scope="col">Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.JoinsAndLeaves)
                        {
                            <tr>
                                <td class="audit-when">@TimeWords.Utc(row.at)</td>
                                <td>@(row.kind == GuildEventKind.Joined ? "Joined" : row.kind == GuildEventKind.Left ? "Left" : row.kind)</td>
                                <td>@row.detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

<section aria-labelledby="changes">
    <h2 id="changes">Changes made to it on the dashboard</h2>
    @if (Model.Changes.Rows.Count == 0)
    {
        <p>None.</p>
    }
    else
    {
        <p>@TimeWords.Count(Model.ChangeTotal, "change"), newest first.</p>
        <partial name="_AuditRows" model="Model.Changes" />
        @if (Model.ChangeTotal > Model.Changes.Rows.Count)
        {
            <p><a href="@Model.ChangesLink">All of them in the audit log</a></p>
        }
    }
    @if (!Model.ShowsAddresses)
    {
        <p class="muted">Each row's visitor address is shown to the Owner alone.</p>
    }
</section>
<p class="muted">Times are in UTC.</p>
