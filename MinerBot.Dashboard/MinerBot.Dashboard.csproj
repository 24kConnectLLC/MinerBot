<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The web dashboard. It references DataAccessLibrary and MinerBot.Shared and nothing of the bot's or of Steam's, so
       none of their code or secrets can reach it. Every default lives in code, so there's no appsettings.json. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MinerBot.Dashboard</RootNamespace>
    <!-- UseStaticFiles serves wwwroot as it is, so compressed copies would only be extra files in the image -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataAccessLibrary\DataAccessLibrary.csproj" />
    <ProjectReference Include="..\MinerBot.Shared\MinerBot.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MinerBot.Dashboard.Tests" />
  </ItemGroup>

</Project>
