<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinerBot.Dashboard\MinerBot.Dashboard.csproj" />
  </ItemGroup>

  <!-- DataAccessLibrary.Tests' MariaDB fixture, linked rather than moved: it stays theirs, and xunit only finds a collection
       definition inside the test assembly itself. With it, the website's tables it builds its copy from. -->
  <ItemGroup>
    <Compile Include="..\DataAccessLibrary.Tests\Database\MariaDbFixture.cs" Link="Database\MariaDbFixture.cs" />
    <Compile Include="..\DataAccessLibrary.Tests\Database\DatabaseCollection.cs" Link="Database\DatabaseCollection.cs" />
    <!-- A deadlock as MySql.Data reports one, for the armor review's transaction that runs again -->
    <Compile Include="..\DataAccessLibrary.Tests\MySqlErrors.cs" Link="Database\MySqlErrors.cs" />
    <None Include="..\docs\schema\wordpress-tables.sql" Link="schema\wordpress-tables.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- The dashboard's own database login, made with the rights deploy gives it, for the Sessions page's checks as that login -->
    <Compile Include="..\DataAccessLibrary.Tests\Database\DashboardLogin.cs" Link="Database\DashboardLogin.cs" />
    <None Include="..\deploy\dashboard-rights.sql" Link="deploy\dashboard-rights.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- nginx's site, whose wait for a page bounds how long one person's send waits for their last: PersonLimitTests reads it -->
    <None Include="..\deploy\minerbot-dashboard.conf" Link="deploy\minerbot-dashboard.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The dashboard's own code, which AuditWordsTests reads for an audit action written anywhere but AuditWords, and
       DataAccessLibrary's beside it, which CodeTests reads for SQL that must never be there -->
  <ItemGroup>
    <None Include="..\MinerBot.Dashboard\**\*.cs" Exclude="..\MinerBot.Dashboard\bin\**;..\MinerBot.Dashboard\obj\**"
          Link="dashboard-source\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\DataAccessLibrary\**\*.cs" Exclude="..\DataAccessLibrary\bin\**;..\DataAccessLibrary\obj\**"
          Link="data-source\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- The bot's two lists of its event kinds, read as text by StatusRulesTests and AuditWordsTests, so a kind the bot gains
       without a label fails there. A kind BotEvents' list names from another file fails StatusRulesTests until that file
       is added here. Copied, never compiled: the dashboard and its tests reference nothing of the bot's. -->
  <ItemGroup>
    <None Include="..\MinerBot 2.0\Status\BotEvents.cs" Link="bot-source\BotEvents.cs" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\SteamWebAPIAccess\SteamStatus.cs" Link="bot-source\SteamStatus.cs" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- The bot's request actions, whose restart rule the controls page states: ControlsPageTests reads it -->
    <None Include="..\MinerBot 2.0\Requests\RequestActions.cs" Link="bot-source\RequestActions.cs" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- The bot's words for the requests it refuses, whose two for a row the dashboard didn't sign banner 4 looks for:
         RequestBannerTests reads it -->
    <None Include="..\MinerBot 2.0\Requests\RequestTexts.cs" Link="bot-source\RequestTexts.cs" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Testcontainers.MariaDb" Version="4.16.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
