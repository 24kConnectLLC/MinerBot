<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinerBot.Dashboard\MinerBot.Dashboard.csproj" />
  </ItemGroup>

  <!-- DataAccessLibrary.Tests' MariaDB fixture, linked rather than moved: it stays theirs, and xunit only finds a collection
       definition inside the test assembly itself. With it, the website's tables it builds its copy from. -->
  <ItemGroup>
    <Compile Include="..\DataAccessLibrary.Tests\Database\MariaDbFixture.cs" Link="Database\MariaDbFixture.cs" />
    <Compile Include="..\DataAccessLibrary.Tests\Database\DatabaseCollection.cs" Link="Database\DatabaseCollection.cs" />
    <!-- A deadlock as MySql.Data reports one, for the armor review's transaction that runs again -->
    <Compile Include="..\DataAccessLibrary.Tests\MySqlErrors.cs" Link="Database\MySqlErrors.cs" />
    <None Include="..\docs\schema\wordpress-tables.sql" Link="schema\wordpress-tables.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Testcontainers.MariaDb" Version="4.16.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
