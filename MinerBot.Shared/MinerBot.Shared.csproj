<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rules and formats that the bot and the dashboard both use. It references nothing outside .NET itself,
       so neither app pulls in the other's Discord, Steam, web or database code through it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
